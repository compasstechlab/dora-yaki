# Environment (development/production)
ENVIRONMENT=development

# ==========
# for Deploy
# ==========
# GCP region used by Makefile deploy targets
GCP_REGION=asia-northeast1

# Backend Cloud Functions gen2 deployment
BACKEND_FUNCTION_NAME=dora-yaki-backend
BACKEND_SERVICE_ACCOUNT_ID=dora-yaki-api
# Backend Cloud Functions gen2 deployment
BACKEND_OAUTH_REDIRECT_URL=https://dora-yaki-api-abc.a.run.app/api/auth/github/callback
BACKEND_FRONTEND_URL=https://dora-yaki-frontend-abc.a.run.app

# Frontend deployment names
FRONTEND_SERVICE_NAME=dora-yaki-frontend
FRONTEND_IMAGE_REPOSITORY=cloud-run-source-deploy
FRONTEND_CLOUDFLARE_PROJECT_NAME=dora-yaki-frontend
FIREBASE_PROJECT_ID=your-gcp-project-id
# Optional: override the frontend build-time API base used by deploy targets.
# DEPLOY_VITE_API_BASE=https://<backend-domain>/api

# ==========
# for Backend
# ==========
# Google Cloud Project ID
GCP_PROJECT_ID=your_gcp_project_id
# Timezone offset (e.g. "+09:00", "-05:30"). Defaults to UTC if empty
TZ_OFFSET=+09:00

# --- GitHub OAuth App ---
# Create at https://github.com/settings/developers
# Authorization callback URL must match OAUTH_REDIRECT_URL below.
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
# Backend callback endpoint registered with the OAuth App.
OAUTH_REDIRECT_URL=http://localhost:7202/api/auth/github/callback

# --- Session signing ---
# Random 32+ byte secret. Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=replace_with_openssl_rand_base64_32
# Optional: cookie domain (leave blank for localhost dev).
# AUTH_COOKIE_DOMAIN=.example.com

# --- Frontend origin for post-login redirect ---
FRONTEND_URL=http://localhost:7201

# --- Scheduler/job endpoint auth ---
# Shared key for /api/job/* endpoints. Generate with: openssl rand -base64 32
JOB_AUTH_KEY=replace_with_openssl_rand_base64_32

# --- Token-at-rest encryption ---
# Local dev: provide a 32-byte AES-256 key. Generate with: openssl rand -base64 32
ENCRYPTION_KEY_BASE64=replace_with_openssl_rand_base64_32
# Production deploy: prefer Cloud KMS instead. Makefile maps this to runtime ENCRYPTION_KMS_KEY.
# BACKEND_ENCRYPTION_KMS_KEY=projects/.../locations/.../keyRings/.../cryptoKeys/...

# ==========
# for Frontend
# ==========
# default language (ja, en, zh-TW, zh-CN, ko, es, fr, de)
VITE_DEFAULT_LOCALE=ja
# API base URL (default: /api for dev proxy)
VITE_API_BASE=/api
